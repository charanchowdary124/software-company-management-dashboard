# Supabase Client Configuration (React / Vite)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# PostgreSQL / Supabase Database Direct Connection (PHP Backend)
# (Optional: the PHP application automatically uses local mock data if not set)
DB_HOST=db.your-project.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-database-password-here
